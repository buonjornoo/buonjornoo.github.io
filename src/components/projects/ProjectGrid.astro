---
import ProjectCard from './ProjectCard.astro';

interface Project {
  title: string;
  description: string;
  tags: string[];
  coverImage?: string;
  slug: string;
  pageNumber: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 auto-rows-fr gap-[2ch]">
  {projects.map((project) => (
    <ProjectCard
      title={project.title}
      description={project.description}
      tags={project.tags}
      coverImage={project.coverImage}
      slug={project.slug}
      pageNumber={project.pageNumber}
    />
  ))}
</div>
