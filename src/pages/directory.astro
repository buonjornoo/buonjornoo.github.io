---
import PageLayout from '../layouts/PageLayout.astro';
import DoubleHeight from '../components/teletext/DoubleHeight.astro';
import Separator from '../components/teletext/Separator.astro';
import DirectoryListing from '../components/teletext/DirectoryListing.astro';
---

<PageLayout
  title="Directory"
  description="Every page on this site, by number."
  pageNumber="101"
>
  <section class="mb-[2ch]">
    <DoubleHeight as="h1" color="text-teletext-white">Directory</DoubleHeight>
    <p class="text-teletext-cyan mt-[1ch]">
      Every page on this site, by number.
    </p>
  </section>

  <Separator color="text-teletext-cyan" char="─" />

  <section class="my-[2ch]">
    <DirectoryListing />
  </section>
</PageLayout>
