---
import PageLayout from '../layouts/PageLayout.astro';
import DoubleHeight from '../components/teletext/DoubleHeight.astro';
import Separator from '../components/teletext/Separator.astro';
import experienceData from '../data/experience.json';
import pageRoutes from '../data/pageRoutes.json';

const copy = experienceData.copy;

/**
 * pageRoutes.json is the one number→URL map (CLAUDE.md). This page references
 * other pages by number only and resolves the URL here, so a route that moves
 * cannot leave a stale link behind — the build fails instead.
 */
const routes: Record<string, string> = pageRoutes;
function urlFor(pageNumber: string): string {
  const url = routes[pageNumber];
  if (!url) throw new Error(`experience.json references unmapped page ${pageNumber}`);
  return url;
}

const title = 'Experience';
const description =
  "Jorne Siebrands' career at a glance — product design and product management across digital office 24, Bikemap, KION Group and Cheil Germany.";
const pageNumber = '102';
const readoutLines = [
  { key: 'description', value: JSON.stringify(description) },
  { key: 'pageNumber', value: JSON.stringify(pageNumber) },
];
---

<PageLayout title={title} description={description} pageNumber={pageNumber}>
  <Separator />

  <section class="mb-[2ch]">
    <DoubleHeight as="h1" color="text-teletext-white">Experience</DoubleHeight>
    <Separator />
    <div class="frontmatter-readout">{readoutLines.map((line, i) => (
      <Fragment>{i > 0 ? '\n' : ''}<span class="fr-key">{line.key}:</span> <span class="fr-value">{line.value}</span></Fragment>
    ))}</div>
  </section>

  <Separator />

  <section class="my-[2ch]">
    <h2 class="text-teletext-white mb-[1ch]">{experienceData.headings.employment}</h2>
    <ul class="list-none space-y-[1ch]">
      {experienceData.employers.map((job) => (
        <li>
          <span class="text-teletext-white font-bold">{job.employer}</span>
          <br />
          <span class="text-teletext-cyan">{job.role}</span>
          <br />
          <span class="text-teletext-grey">{job.years}</span>
        </li>
      ))}
    </ul>
  </section>

  <Separator />

  <section class="my-[2ch]">
    <h2 class="text-teletext-white mb-[1ch]">{experienceData.headings.personalProjects}</h2>
    <ul class="list-none space-y-[1ch]">
      {experienceData.personalProjects.map((project) => (
        <li>
          <span class="text-teletext-white font-bold">{project.name}</span>
          {' '}{copy.projectRefLead}{' '}
          <a href={urlFor(project.number)}>{copy.pageLinkLabel} {project.number}</a>
        </li>
      ))}
    </ul>
  </section>

  <Separator />

  <section class="my-[2ch]">
    <h2 class="text-teletext-white mb-[1ch]">{experienceData.headings.education}</h2>
    <ul class="list-none space-y-[1ch]">
      {experienceData.education.map((edu) => (
        <li>
          <span class="text-teletext-white font-bold">
            {edu.degree}, {edu.subject}
          </span>
          <br />
          <span class="text-teletext-cyan">{edu.school}</span>
          <br />
          <span class="text-teletext-grey">{edu.years}</span>
          {edu.thesis && (
            <span class="block text-teletext-grey mt-[0.5ch]">
              {copy.thesisLabel}{' '}
              <a href={urlFor(edu.thesis.number)}>{edu.thesis.title}</a>{' '}
              {copy.thesisRefLead} {edu.thesis.number}
            </span>
          )}
        </li>
      ))}
    </ul>
  </section>

  <Separator />

  <section class="my-[2ch]">
    <h2 class="text-teletext-white mb-[1ch]">{experienceData.headings.skills}</h2>
    <dl class="space-y-[1ch]">
      {experienceData.skills.map((skill) => (
        <div>
          <dt class="text-teletext-grey font-bold">{skill.label}</dt>
          <dd class="text-teletext-white">{skill.value}</dd>
        </div>
      ))}
    </dl>
  </section>

</PageLayout>

<style>
  .frontmatter-readout {
    font-family: var(--font-teletext);
    font-size: 1rem;
    white-space: pre-wrap;
    margin-top: 1ch;
    margin-bottom: 2ch;
  }
  .frontmatter-readout .fr-key {
    color: var(--color-teletext-grey);
  }
  .frontmatter-readout .fr-value {
    color: var(--color-teletext-white);
  }
</style>
