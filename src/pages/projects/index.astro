---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import DoubleHeight from '../../components/teletext/DoubleHeight.astro';
import Separator from '../../components/teletext/Separator.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects
  .map((p) => p.data)
  .filter((p) => !p.archive)
  .sort((a, b) => a.order - b.order);

const title = 'Projects';
const description =
  'Explore Product Design and Product Management projects by Jorne Marc Siebrands — cycling apps, AR technology, and more.';
const pageNumber = '200';
const readoutLines = [
  { key: 'description', value: JSON.stringify(description) },
  { key: 'pageNumber', value: JSON.stringify(pageNumber) },
];
---

<PageLayout title={title} description={description} pageNumber={pageNumber}>
  <Separator />

  <section class="mb-[2ch]">
    <DoubleHeight as="h1" color="text-teletext-white">My Projects</DoubleHeight>
    <Separator />
    <div class="frontmatter-readout">{readoutLines.map((line, i) => (
      <Fragment>{i > 0 ? '\n' : ''}<span class="fr-key">{line.key}:</span> <span class="fr-value">{line.value}</span></Fragment>
    ))}</div>
  </section>

  <Separator />

  <h2 class="text-teletext-white font-bold text-teletext-lg mb-[2ch]">
    A selection of projects in Product Design and Product Management.
  </h2>

  <ProjectGrid projects={sortedProjects} />
</PageLayout>

<style>
  .frontmatter-readout {
    font-family: var(--font-teletext);
    font-size: 1rem;
    white-space: pre-wrap;
    margin-top: 1ch;
    margin-bottom: 2ch;
  }
  .frontmatter-readout .fr-key {
    color: var(--color-teletext-grey);
  }
  .frontmatter-readout .fr-value {
    color: var(--color-teletext-white);
  }
</style>
