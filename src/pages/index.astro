---
import PageLayout from '../layouts/PageLayout.astro';
import Separator from '../components/teletext/Separator.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { getEntry, getCollection, render } from 'astro:content';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Home page content not found');
const { Content } = await render(home);

const readoutLines = [
  { key: 'title', value: JSON.stringify(home.data.title) },
  { key: 'description', value: JSON.stringify(home.data.description) },
  { key: 'pageNumber', value: JSON.stringify(home.data.pageNumber) },
];

const curatedSlugs = [
  'do24-workflow-evolution', // FEATURED treatment = position 0
  'bikemap-route-planner',
  'table-hunter',
  'bikemap-pause-mode',
  'do24-teal-ui',
];
const allProjects = await getCollection('projects');
const caseStudies = curatedSlugs.map((s) => allProjects.find((p) => p.data.slug === s)!.data);
---

<PageLayout
  title={home.data.title}
  description={home.data.description}
  pageNumber={home.data.pageNumber}
  headerLabel="Home"
>
  <!-- Metadata readout: reuses the frontmatter-readout pattern (DESIGNSYSTEM.md),
       previously project-pages-only — the homepage is a Ceefax service page, not
       a bio card, so it gets the same raw-frontmatter treatment (JOR-75). -->
  <section class="mb-[2ch]">
    <div class="frontmatter-readout">{readoutLines.map((line, i) => (
      <Fragment>{i > 0 ? '\n' : ''}<span class="fr-key">{line.key}:</span> <span class="fr-value">{line.value}</span></Fragment>
    ))}</div>
  </section>

  <Separator />

  <!-- How to use -->
  <section class="my-[2ch]">
    <h2 class="text-teletext-white font-bold text-teletext-lg mb-[1ch]">How to use this site</h2>
    <p class="text-teletext-white leading-relaxed mt-[1ch]">
      Every page has a 3-digit number — you're on 100 right now. Type any number on your keyboard
      to jump straight there, the way Ceefax worked. On desktop, the remote control on the right
      does the same job with the mouse; on mobile, tap the page number above to open it.
    </p>
  </section>

  <Separator />

  <!-- Curated Case Studies -->
  <section class="my-[2ch]">
    <h2 class="text-teletext-white font-bold text-teletext-lg mb-[1ch]">Curated Case Studies</h2>
    <div class="flex flex-col gap-[2ch] mt-[2ch]">
      {caseStudies.map((project, i) => (
        <ProjectCard {...project} layout="horizontal" featured={i === 0} />
      ))}
    </div>
  </section>

  <Separator />

  <!-- Get in Touch (rendered from home.md) -->
  <div class="prose-teletext my-[2ch]">
    <Content />
  </div>
</PageLayout>

<style>
  .frontmatter-readout {
    font-family: var(--font-teletext);
    font-size: 1rem;
    white-space: pre-wrap;
    margin-top: 1ch;
    margin-bottom: 2ch;
  }
  .frontmatter-readout .fr-key {
    color: var(--color-teletext-grey);
  }
  .frontmatter-readout .fr-value {
    color: var(--color-teletext-white);
  }
  .prose-teletext :global(h2) {
    color: var(--color-teletext-white);
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 2em;
    margin-bottom: 0.5em;
  }
  .prose-teletext :global(p) {
    margin-bottom: 1em;
    line-height: 1.5;
  }
  .prose-teletext :global(a) {
    color: var(--color-teletext-cyan);
  }
  .prose-teletext :global(a:hover) {
    color: var(--color-teletext-yellow);
  }
  .prose-teletext :global(hr) {
    border: none;
    border-top: 1px solid var(--color-teletext-green);
    opacity: 0.5;
    margin: 2em 0;
  }
</style>
