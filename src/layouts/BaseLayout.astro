---
import '../styles/global.css';
import SEOHead from '../components/seo/SEOHead.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import RemoteControl from '../components/teletext/RemoteControl.astro';
import pageRoutes from '../data/pageRoutes.json';
import { neighbourPageNumber } from '../lib/teletext-nav';

interface Props {
  title: string;
  description: string;
  pageNumber?: string;
  ogImage?: string;
  canonicalURL?: string;
  sectionCount?: number;
}

const { title, description, pageNumber = '100', ogImage, canonicalURL, sectionCount = 0 } = Astro.props;
const routesJson = JSON.stringify(pageRoutes);

// Contextual neighbour affordance (issues/11): reuses issue 10's own
// ascending walk, keyed directly off this page's own pageNumber prop —
// no reverse URL lookup needed, we already have the number. Omitted
// entirely when pageNumber isn't itself in the route map (e.g. /404).
const routes: Record<string, string> = pageRoutes;
const prevNeighbour = neighbourPageNumber(routes, pageNumber, 'prev');
const nextNeighbour = neighbourPageNumber(routes, pageNumber, 'next');
const pageNeighbours =
  prevNeighbour && nextNeighbour
    ? {
        prevNumber: prevNeighbour,
        prevUrl: routes[prevNeighbour],
        nextNumber: nextNeighbour,
        nextUrl: routes[nextNeighbour],
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
    />
    <JsonLd />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9T9M59GHTP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9T9M59GHTP');
    </script>

    <!-- Preload font -->
    <link rel="preload" href="/fonts/bedstead.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body
    class="min-h-screen flex flex-col bg-teletext-black text-teletext-white font-teletext"
    data-routes={routesJson}
    data-page-number={pageNumber}
    data-section-count={sectionCount}
  >
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:px-[2ch] focus:py-2 focus:bg-teletext-yellow focus:text-teletext-black font-bold">
      Skip to content
    </a>

    <!-- Ceefax header row -->
    <header class="ceefax-header">
      <a href="/" class="ceefax-service-name" aria-label="SIEBRANDS — go to home page">SIEBRANDS</a>
      <span class="ceefax-identity">Product Designer · PM</span>
      <button id="page-number-btn" class="ceefax-page-number" aria-label="Enter page number">
        <span class="ceefax-buffer">P<span id="page-number-display">{pageNumber}</span></span>
      </button>
      <!-- Announced text lives in a passive wrapper beside the button (not
           inside it): controls named via aria-label can swallow inner text
           changes in some screen readers. Mirrors RemoteControl's pattern. -->
      <span id="page-number-live" class="sr-only" aria-live="polite" aria-atomic="true">{pageNumber}</span>
      <div class="ceefax-page-title">
        <span class="page-title-full">
          {title}
          {sectionCount >= 1 && <> <span class="section-counter-value">1/{sectionCount}</span></>}
        </span>
        {sectionCount >= 1 && (
          <span class="page-title-compact section-counter-value">1/{sectionCount}</span>
        )}
      </div>
      <span id="header-date" class="ceefax-date"></span>
      <span id="clock" class="ceefax-clock"></span>
    </header>

    <!-- Page content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Fastext footer -->
    <footer class="ceefax-footer">
      {pageNeighbours && (
        <div class="page-nav-neighbours" aria-label="Adjacent pages">
          <a href={pageNeighbours.prevUrl} aria-label={`Previous page, ${pageNeighbours.prevNumber}`}>
            ◀ {pageNeighbours.prevNumber}
          </a>
          <span aria-hidden="true">·</span>
          <a href={pageNeighbours.nextUrl} aria-label={`Next page, ${pageNeighbours.nextNumber}`}>
            {pageNeighbours.nextNumber} ▶
          </a>
        </div>
      )}
      <nav class="ceefax-fastext" aria-label="Quick navigation">
        <a href="/" class="fastext-btn fastext-red">
          <span class="fastext-label">Home</span>
          <span class="fastext-number">100</span>
        </a>
        <a href="/projects/" class="fastext-btn fastext-green">
          <span class="fastext-label">Projects</span>
          <span class="fastext-number">200</span>
        </a>
        <a href="/blog/" class="fastext-btn fastext-yellow">
          <span class="fastext-label">Blog</span>
          <span class="fastext-number">300</span>
        </a>
        <a href="/contact/" class="fastext-btn fastext-cyan">
          <span class="fastext-label">Contact</span>
          <span class="fastext-number">400</span>
        </a>
      </nav>
    </footer>

    <!-- CRT scanline overlay -->
    <div class="crt-scanlines" aria-hidden="true"></div>

    <!-- Ceefax remote control (desktop rail + mobile/mid-width dialog) -->
    <RemoteControl pageNumber={pageNumber} />

    <!-- Keyboard navigation + remote keypad + Clock.
         Bundled (not is:inline) so the decision core in src/lib/teletext-nav.ts
         stays unit-testable; config rides in as body data attributes. -->
    <script>
      import { initTeletextNav } from '../lib/teletext-nav';
      import { initSectionCounter } from '../lib/section-counter';

      initTeletextNav({
        routes: JSON.parse(document.body.dataset.routes ?? '{}'),
        currentPage: document.body.dataset.pageNumber ?? '100',
      });

      initSectionCounter({
        count: Number(document.body.dataset.sectionCount ?? '0'),
      });
    </script>
  </body>
</html>
